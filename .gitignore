# ───────────────────────────────────────────────────────────
#  selfnas .gitignore
#
#  原则：凡是「能重新生成的」和「属于某个人的」，都不进仓库。
#  前者进仓库会让 diff 变噪音，后者进仓库就是事故。
# ───────────────────────────────────────────────────────────

# ── 编译产物 ──────────────────────────────────────────────
selfnas.exe
selfnas
*.exe
*.dll
*.so
*.dylib

# ── 日志 ──────────────────────────────────────────────────
# 注意：*.log 不会误伤 log.go（扩展名不同）
*.log
logs/
run.log

# ── 用户数据：绝不入库 ────────────────────────────────────
# 「最近 / 收藏」存在 SQLite 里，是跟账号绑定的个人数据。
# -wal / -shm 三件套必须一起忽略：主库可能只有几十 KB，
# 还没合并的记录全在 -wal 里，只提交 .db 等于提交了半份数据。
selfnas.db
selfnas.db-wal
selfnas.db-shm

# 转码缓存，能到几十 G
cache/

# 分片上传的中间文件：.part 是半成品，.part.meta 是已完成区间表
*.part
*.part.meta

# ── 本地配置：含密码哈希与会话签名密钥 ────────────────────
# secret 泄露 = 任何人都能伪造登录态和分享链接签名
config.json
config.json.bak
config.json.bak-*
config.yaml
config.local.json
# 保存配置时先写 .tmp 再原子替换，崩溃时会残留
config.json.tmp
.env
.env.*

# ── 开发过程产物 ──────────────────────────────────────────
# 截图、自动化测试脚本、数据救援脚本
preview-*.png
_测试/
_救援/
*.bak
*.tmp
*.orig
*.rej

# ── 测试与性能 ────────────────────────────────────────────
*.test
*.out
coverage.out
*.prof

# ── 编辑器 ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.history/

# ── 发布产物 ──────────────────────────────────────────────
# scripts/release.py 生成的跨平台二进制和压缩包，由 Release 页承载，不进仓库
dist/

# ── 操作系统 ──────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.Spotlight-V100
.Trashes
